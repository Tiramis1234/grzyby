@using Microsoft.AspNetCore.Identity
@using grzyby.Models

<nav class="nav">
    <a class="logo" href="">
        <span class="logo-dot"></span>Atlas Grzybów
    </a>

    <div class="nav-links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink class="nav-link" href="wiki">Wiki</NavLink>
        <NavLink class="nav-link" href="forum">Forum</NavLink>
    </div>

    <div class="nav-right">
        <AuthorizeView>
            <Authorized>
                <span class="btn-sm" style="color:var(--cu); font-family:var(--fm); font-size:0.62rem;">
                    @context.User.Identity?.Name
                </span>
                <form action="/logout" method="post" class="d-inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-sm btn-outline">Wyloguj</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <a class="btn-sm btn-outline" href="login">Zaloguj</a>
                <a class="btn-sm btn-dark-custom" href="register">Rejestracja</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
