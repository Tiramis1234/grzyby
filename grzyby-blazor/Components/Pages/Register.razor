@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using grzyby.Models
@inject UserManager<User> UserManager
@inject NavigationManager Navigation

<PageTitle>Rejestracja</PageTitle>

<div class="main-wrap" style="grid-template-columns:1fr; max-width:440px;">
    <main>
        <div style="background:var(--cr); border:1px solid var(--cf); border-radius:8px; padding:32px;">
            <div style="text-align:center; margin-bottom:28px;">
                <div style="width:48px; height:48px; border-radius:50%; background:var(--cs); color:var(--cm); display:inline-flex; align-items:center; justify-content:center; font-size:1.3rem; margin-bottom:12px;">
                    <i class="bi bi-person-plus"></i>
                </div>
                <h2 style="font-family:var(--fs); font-size:1.3rem; font-weight:600; color:var(--cb); margin:0 0 4px;">Stwórz konto</h2>
                <p style="color:var(--cu); font-size:0.82rem; margin:0;">Dołącz do społeczności grzybiarzy</p>
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div style="background:var(--ccll); color:var(--ccl); border-radius:8px; padding:10px 14px; font-size:0.82rem; font-weight:600; text-align:center; margin-bottom:16px;">
                    <i class="bi bi-exclamation-triangle"></i> @((MarkupString)ErrorMessage)
                </div>
            }

            <EditForm Model="Input" method="post" FormName="RegisterForm" OnValidSubmit="RegisterUser">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label style="font-size:0.72rem; font-weight:600; text-transform:uppercase; color:var(--cud); display:block; margin-bottom:4px;">
                        <i class="bi bi-envelope"></i> Adres E-mail
                    </label>
                    <InputText @bind-Value="Input.Email" class="form-control border-0 p-3" style="background:var(--cp); font-size:0.9rem;" placeholder="nazwa@email.com" />
                    <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
                </div>

                <div class="mb-3">
                    <label style="font-size:0.72rem; font-weight:600; text-transform:uppercase; color:var(--cud); display:block; margin-bottom:4px;">
                        <i class="bi bi-lock"></i> Hasło
                    </label>
                    <InputText @bind-Value="Input.Password" type="password" class="form-control border-0 p-3" style="background:var(--cp); font-size:0.9rem;" placeholder="Minimum 6 znaków" />
                    <ValidationMessage For="() => Input.Password" class="text-danger small mt-1" />
                </div>

                <div class="mb-4">
                    <label style="font-size:0.72rem; font-weight:600; text-transform:uppercase; color:var(--cud); display:block; margin-bottom:4px;">
                        <i class="bi bi-lock-fill"></i> Powtórz Hasło
                    </label>
                    <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control border-0 p-3" style="background:var(--cp); font-size:0.9rem;" placeholder="Potwierdź hasło" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small mt-1" />
                </div>

                <button type="submit" class="btn-primary-custom" style="width:100%; justify-content:center; padding:10px; border:none;">
                    <i class="bi bi-person-plus"></i> Zarejestruj się
                </button>

                <div style="text-align:center; margin-top:20px; padding-top:16px; border-top:1px solid var(--cf); color:var(--cu); font-size:0.82rem;">
                    Masz już konto?<br>
                    <a href="/login" style="color:var(--ccl); font-weight:600; text-decoration:none; margin-top:4px; display:inline-block;">
                        Przejdź do logowania <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </EditForm>
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromForm] public RegisterModel Input { get; set; } = default!;
    private string? ErrorMessage;
    protected override void OnInitialized() { Input ??= new RegisterModel(); }

    private async Task RegisterUser()
    {
        var user = new User { UserName = Input.Email, Email = Input.Email, CreatedAt = DateTime.UtcNow };
        var result = await UserManager.CreateAsync(user, Input.Password);
        if (result.Succeeded) Navigation.NavigateTo("/login");
        else ErrorMessage = string.Join("<br>", result.Errors.Select(e => e.Description));
    }

    public class RegisterModel
    {
        [Required] [EmailAddress] public string Email { get; set; } = "";
        [Required] [StringLength(100, MinimumLength = 6)] public string Password { get; set; } = "";
        [Compare(nameof(Password))] public string ConfirmPassword { get; set; } = "";
    }
}
