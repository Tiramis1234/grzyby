@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using grzyby.Models
@inject UserManager<User> UserManager
@inject NavigationManager Navigation

<PageTitle>Rejestracja</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <span class="display-4">🌱</span>
                    <h2 class="fw-bold mt-2 text-chocolate">Stwórz konto</h2>
                    <p class="text-muted">Dołącz do społeczności grzybiarzy</p>
                </div>
                
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger rounded-4 shadow-sm border-0 fw-bold text-center">@((MarkupString)ErrorMessage)</div>
                }

                <EditForm Model="Input" method="post" FormName="RegisterForm" OnValidSubmit="RegisterUser">
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="form-label text-chocolate small fw-bold text-uppercase">Adres E-mail</label>
                        <InputText @bind-Value="Input.Email" class="form-control form-control-lg bg-light border-0 p-3 rounded-3" placeholder="nazwa@email.com" />
                        <ValidationMessage For="() => Input.Email" class="text-danger small mt-1 fw-bold" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-chocolate small fw-bold text-uppercase">Hasło</label>
                        <InputText @bind-Value="Input.Password" type="password" class="form-control form-control-lg bg-light border-0 p-3 rounded-3" placeholder="Minimum 6 znaków" />
                        <ValidationMessage For="() => Input.Password" class="text-danger small mt-1 fw-bold" />
                    </div>

                    <div class="mb-5">
                        <label class="form-label text-chocolate small fw-bold text-uppercase">Powtórz Hasło</label>
                        <InputText @bind-Value="Input.ConfirmPassword" type="password" class="form-control form-control-lg bg-light border-0 p-3 rounded-3" placeholder="Potwierdź hasło" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small mt-1 fw-bold" />
                    </div>

                    <button type="submit" class="btn bg-forest btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm transition-hover">
                        Zarejestruj się
                    </button>
                    
                    <div class="text-center mt-4 text-muted pt-3 border-top">
                        Masz już swoje konto? <br>
                        <a href="/login" class="text-golden fw-bold text-decoration-none mt-2 d-inline-block transition-hover">Przejdź do logowania</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] public RegisterModel Input { get; set; } = default!;
    private string? ErrorMessage;
    protected override void OnInitialized() { Input ??= new RegisterModel(); }

    private async Task RegisterUser()
    {
        var user = new User { UserName = Input.Email, Email = Input.Email, CreatedAt = DateTime.UtcNow };
        var result = await UserManager.CreateAsync(user, Input.Password);
        if (result.Succeeded) Navigation.NavigateTo("/login");
        else ErrorMessage = string.Join("<br>", result.Errors.Select(e => e.Description));
    }

    public class RegisterModel
    {
        [Required] [EmailAddress] public string Email { get; set; } = "";
        [Required] [StringLength(100, MinimumLength = 6)] public string Password { get; set; } = "";
        [Compare(nameof(Password))] public string ConfirmPassword { get; set; } = "";
    }
}