@page "/"

<PageTitle>Strona Główna - Atlas Grzybów</PageTitle>

<div class="container py-4">
    <!-- Hero Section -->
    <div class="text-center shadow-sm rounded-4" style="background: linear-gradient(135deg, #f2f5f1 0%, #e6ece4 100%); padding: 5rem 2rem; margin-bottom: 4rem; border: 1px solid rgba(67, 106, 54, 0.15);">
        <span class="display-1 d-block mb-3">🍄🌲</span>
        <h1 class="display-4 fw-bold text-chocolate mb-4" style="letter-spacing: -1px;">
            Witaj! <br>
        </h1>
        <p class="lead text-secondary mb-5 mx-auto" style="max-width: 750px; line-height: 1.8;">
            Twoje wirtualne kompendium wiedzy o grzybach polskich lasów. Odkrywaj nowe gatunki, dziel się swoimi zbiorami i rozmawiaj z innymi pasjonatami grzybobrania.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
           <a href="/wiki" class="btn border-chocolate text-chocolate bg-white rounded-pill px-5 py-3 fw-bold transition-hover">
                Przeglądaj Atlas
            </a>
            <a href="/forum" class="btn border-chocolate text-chocolate bg-white rounded-pill px-5 py-3 fw-bold transition-hover">
                Wejdź na Forum
            </a>
        </div>
    </div>

    <!-- Features -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 text-center transition-hover h-100">
                <div class="rounded-4 mx-auto mb-4 d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2.2rem; background-color: rgba(67, 106, 54, 0.15);">
                    <span class="text-olive">🌿</span>
                </div>
                <h4 class="fw-bold mb-3 text-chocolate">Ogromny Atlas</h4>
                <p class="text-muted mb-0 lh-lg">Poznaj setki gatunków grzybów. Dowiedz się, które są najsmaczniejsze, a których bezwzględnie unikać.</p>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 text-center transition-hover h-100">
                <div class="rounded-4 mx-auto mb-4 d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2.2rem; background-color: rgba(178, 148, 87, 0.15);">
                    <span class="text-golden">👥</span>
                </div>
                <h4 class="fw-bold mb-3 text-chocolate">Aktywne Forum</h4>
                <p class="text-muted mb-0 lh-lg">Znalazłeś nietypowego grzyba? Chcesz pochwalić się koszem prawdziwków? Społeczność czeka!</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 text-center transition-hover h-100">
                <div class="rounded-4 mx-auto mb-4 d-inline-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2.2rem; background-color: rgba(152, 110, 52, 0.15);">
                    <span class="text-caramel">⭐</span>
                </div>
                <h4 class="fw-bold mb-3 text-chocolate">Społeczność</h4>
                <p class="text-muted mb-0 lh-lg">Zarejestruj się, aby móc komentować i tworzyć własne wątki. Zbuduj swój profil na naszym portalu.</p>
            </div>
        </div>
    </div>
</div>