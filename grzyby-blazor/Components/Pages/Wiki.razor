@page "/wiki"
@using grzyby.Data
@using grzyby.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>WIKI - Atlas Grzybów</PageTitle>

<div class="main-wrap" style="grid-template-columns:1fr; max-width:960px;">
    <main>
        <div style="text-align:center; margin-bottom:32px;">
            <div class="eyebrow" style="justify-content:center; margin-bottom:12px;">
                <span class="logo-dot"></span>Przewodnik
            </div>
            <h1 style="font-family:var(--fs); font-size:2rem; font-weight:600; color:var(--cb); margin:0 0 8px;">
                Atlas Grzybów
            </h1>
            <p style="color:var(--cu); font-size:0.9rem; margin:0;">
                Poznaj najpopularniejsze gatunki występujące w polskich lasach.
            </p>
        </div>

        <form method="get" action="/wiki" class="row justify-content-center mb-5">
            <div class="col-md-8 col-lg-6">
                <div class="input-group shadow-sm rounded-pill overflow-hidden" style="border:1px solid var(--cf);">
                    <input type="text" name="search" value="@Search" class="form-control border-0 px-4 py-3 shadow-none"
                           style="background:var(--cr); font-size:0.9rem;" placeholder="Wpisz nazwę grzyba..." />
                    <button type="submit" class="btn px-4" style="background:var(--cud); color:var(--cr); border:none;">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </form>

        @if (grzyby is null)
        {
            <div style="text-align:center;padding:48px 0;">
                <div class="spinner-border" role="status" style="color:var(--cm);"></div>
            </div>
        }
        else if (!grzyby.Any())
        {
            <div style="text-align:center;padding:40px 0; background:var(--cr); border:1px solid var(--cf); border-radius:8px;">
                <div style="font-size:2.5rem; color:var(--cf); margin-bottom:8px;">
                    <i class="bi bi-search"></i>
                </div>
                <h5 style="font-family:var(--fs); color:var(--cud);">Nie znaleziono żadnych grzybów!</h5>
                <p style="color:var(--cu); font-size:0.82rem;">Brak wyników dla: <strong>@Search</strong></p>
                <a href="/wiki" class="btn-ghost" style="display:inline-flex;margin-top:8px;">
                    <i class="bi bi-arrow-left"></i> Wróć do pełnej listy
                </a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
                @foreach (var grzyb in grzyby)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-hover" style="background:var(--cr);">
                            <img src="@grzyb.ZdjecieUrl"
                                 class="card-img-top"
                                 alt="@grzyb.Nazwa"
                                 style="height:200px; object-fit:cover;" />

                            <div class="card-body d-flex flex-column p-3">
                                <h5 style="font-family:var(--fs); font-weight:600; color:var(--cud); margin:0 0 2px; font-size:0.95rem;">@grzyb.Nazwa</h5>
                                <span style="color:var(--cu); font-size:0.72rem; margin-bottom:8px;">
                                    <i class="bi bi-tag"></i> @grzyb.Rodzina
                                </span>

                                <p style="font-size:0.82rem; color:var(--cu); flex-grow:1; line-height:1.5; margin:0 0 8px;">
                                    @Truncate(grzyb.Opis, 100)
                                </p>

                                <div class="pt-2 border-top text-center" style="border-color:var(--cf) !important;">
                                    @if (grzyb.Jadalny)
                                    {
                                        <span class="badge w-100 py-2 rounded-pill" style="background:var(--cs); color:var(--cm); font-size:0.72rem;">
                                            <i class="bi bi-check-circle"></i> Jadalny
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge w-100 py-2 rounded-pill" style="background:var(--ccll); color:var(--ccl); font-size:0.72rem;">
                                            <i class="bi bi-exclamation-circle"></i> Trujący / Niejadalny
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-4 d-flex justify-content-center">
                    <ul class="pagination mb-0" style="gap:4px;">
                        <li class="page-item @(Page <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3" style="border:1px solid var(--cf); background:var(--cr); color:var(--cu); font-size:0.8rem;"
                               href="/wiki?page=@(Page - 1)&search=@Search">&laquo;</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            var p = i;
                            <li class="page-item @(Page == p ? "active" : "")">
                                <a class="page-link rounded-pill" style="@(Page == p ? "background:var(--cud); border-color:var(--cud); color:var(--cr);" : "background:var(--cr); border-color:var(--cf); color:var(--cu);") font-size:0.8rem;"
                                   href="/wiki?page=@p&search=@Search">@p</a>
                            </li>
                        }
                        <li class="page-item @(Page >= totalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3" style="border:1px solid var(--cf); background:var(--cr); color:var(--cu); font-size:0.8rem;"
                               href="/wiki?page=@(Page + 1)&search=@Search">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </main>
</div>

@code {
    private List<Grzyb>? grzyby;
    private int pageSize = 20;
    private int totalPages = 1;

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (Page < 1) Page = 1;

        IQueryable<Grzyb> query = Db.Grzyby.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(Search))
        {
            query = query.Where(g => g.Nazwa.ToLower().Contains(Search.ToLower()));
        }

        int totalItems = await query.CountAsync();
        totalPages = totalItems > 0 ? (int)Math.Ceiling((double)totalItems / pageSize) : 1;

        if (Page > totalPages) Page = totalPages;

        grzyby = await query
            .OrderBy(g => g.Nazwa)
            .Skip((Page - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync();
    }

    private static string Truncate(string value, int max)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return value.Length <= max ? value : value[..max] + "...";
    }
}
