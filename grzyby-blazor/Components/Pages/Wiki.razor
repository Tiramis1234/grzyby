@page "/wiki"
@using grzyby.Data
@using grzyby.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>WIKI</PageTitle>

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-dark">Atlas Grzybów</h1>
        <p class="lead text-muted">Poznaj najpopularniejsze gatunki występujące w polskich lasach.</p>
    </div>


    <form method="get" action="/wiki" class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6">
            <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                <input type="text" name="search" value="@Search" class="form-control border-0 px-4 py-3 shadow-none" 
                       placeholder="Wpisz nazwę grzyba..." />
                <button type="submit" class="btn btn-dark px-4">
                    Szukaj
                </button>
            </div>
        </div>
    </form>

    @if (grzyby is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Ładowanie...</span>
            </div>
            <p class="mt-2 text-muted">Trwa ładowanie atlasu...</p>
        </div>
    }
    else if (!grzyby.Any())
    {
        <div class="alert alert-warning text-center rounded-4 shadow-sm py-4" role="alert">
            <h5 class="fw-bold mb-0">Nie znaleziono żadnych grzybów!</h5>
            <small class="text-muted">Brak wyników dla zapytania: <strong>@Search</strong></small>
            <div class="mt-3">
                <a href="/wiki" class="btn btn-outline-dark rounded-pill">Wróć do pełnej listy</a>
            </div>
        </div>
    }
    else
    {
        <!-- KARTY GRZYBÓW -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var grzyb in grzyby)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden transition-hover">
                        <img src="@grzyb.ZdjecieUrl" 
                             class="card-img-top" 
                             alt="@grzyb.Nazwa" 
                             style="height: 220px; object-fit: cover;" />
                        
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold mb-1">@grzyb.Nazwa</h5>
                            <span class="text-muted small mb-3">
                                Rodzina: <strong>@grzyb.Rodzina</strong>
                            </span>
                            
                            <p class="card-text text-secondary flex-grow-1" style="font-size: 0.95rem;">
                                @grzyb.Opis
                            </p>
                            
                            <div class="mt-3 pt-3 border-top text-center">
                                @if (grzyb.Jadalny)
                                {
                                    <span class="badge bg-success text-uppercase py-2 px-3 w-100 rounded-pill">
                                        Jadalny
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-uppercase py-2 px-3 w-100 rounded-pill">
                                        Trujący / Niejadalny
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINACJA -->
        @if (totalPages > 1)
        {
            <nav class="mt-5 d-flex justify-content-center">
                <ul class="pagination pagination-lg shadow-sm">
                    
                    <!-- Przycisk "Poprzednia" -->
                    <li class="page-item @(Page <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-start-pill px-4" href="/wiki?page=@(Page - 1)&search=@Search">
                            &laquo; Wstecz
                        </a>
                    </li>
                    
                    <!-- Numery stron -->
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(Page == pageNumber ? "active" : "")">
                            <a class="page-link" 
                               style="@(Page == pageNumber ? "background-color: #212529; border-color: #212529; color: white;" : "")" 
                               href="/wiki?page=@pageNumber&search=@Search">
                                @pageNumber
                            </a>
                        </li>
                    }
                    
                    <!-- Przycisk "Następna" -->
                    <li class="page-item @(Page >= totalPages ? "disabled" : "")">
                        <a class="page-link rounded-end-pill px-4" href="/wiki?page=@(Page + 1)&search=@Search">
                            Dalej &raquo;
                        </a>
                    </li>

                </ul>
            </nav>
        }
    }
</div>

@code {
    private List<Grzyb>? grzyby;
    private int pageSize = 20; 
    private int totalPages = 1;

    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    protected override async Task OnParametersSetAsync()
    {

        if (Page < 1) 
        {
            Page = 1;
        }

        IQueryable<Grzyb> query = Db.Grzyby.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(Search))
        {
            query = query.Where(g => g.Nazwa.ToLower().Contains(Search.ToLower()));
        }

        int totalItems = await query.CountAsync();
        
        totalPages = totalItems > 0 ? (int)Math.Ceiling((double)totalItems / pageSize) : 1;

        
        if (Page > totalPages) 
        {
            Page = totalPages;
        }

   
        grzyby = await query
            .OrderBy(g => g.Nazwa) 
            .Skip((Page - 1) * pageSize) 
            .Take(pageSize) 
            .ToListAsync();
    }
}