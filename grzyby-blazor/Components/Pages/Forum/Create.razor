@page "/forum/nowy"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using grzyby.Data
@using grzyby.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Nowy Wpis</PageTitle>

<div class="main-wrap" style="grid-template-columns:1fr; max-width:680px;">
    <main>
        <div class="mb-3">
            <a href="/forum" class="btn-ghost" style="display:inline-flex;">
                <i class="bi bi-arrow-left"></i> Wróć do forum
            </a>
        </div>

        <div style="background:var(--cr); border:1px solid var(--cf); border-radius:8px; padding:28px;">
            <div style="margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid var(--cf);">
                <h2 style="font-family:var(--fs); font-size:1.3rem; font-weight:600; color:var(--cb); margin:0;">
                    <i class="bi bi-pencil-square" style="color:var(--ccl); margin-right:8px;"></i>Utwórz nowy wpis
                </h2>
            </div>

            <EditForm Model="Input" method="post" FormName="NowyWpisForm" OnValidSubmit="DodajWpis">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label style="font-weight:600; font-size:0.82rem; color:var(--cud); display:block; margin-bottom:6px;">Tytuł wpisu</label>
                    <InputText @bind-Value="Input.Tytul" class="form-control border-0 p-3" style="background:var(--cp); font-size:0.95rem;" placeholder="Zaciekaw innych swoim tytułem..." />
                    <ValidationMessage For="() => Input.Tytul" class="text-danger small mt-2 fw-bold" />
                </div>

                <div class="mb-5">
                    <label style="font-weight:600; font-size:0.82rem; color:var(--cud); display:block; margin-bottom:6px;">Treść</label>
                    <InputTextArea @bind-Value="Input.Tresc" class="form-control border-0 p-3" rows="10" style="background:var(--cp); font-size:0.95rem;" placeholder="Rozpisz się tutaj... Podziel się relacją z grzybobrania lub zadaj pytanie." />
                    <ValidationMessage For="() => Input.Tresc" class="text-danger small mt-2 fw-bold" />
                </div>

                <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top" style="border-color:var(--cf) !important;">
                    <a href="/forum" class="btn-ghost">Anuluj</a>
                    <button type="submit" class="btn-primary-custom" style="border:none;">
                        <i class="bi bi-send"></i> Opublikuj na forum
                    </button>
                </div>
            </EditForm>
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromForm] public WpisModel Input { get; set; } = default!;
    protected override void OnInitialized() { Input ??= new WpisModel(); }

    private async Task DodajWpis()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            var nowyWpis = new Wpis { Tytul = Input.Tytul, Tresc = Input.Tresc, DataDodania = DateTime.UtcNow, AuthorId = user.Id };
            Db.Wpisy.Add(nowyWpis);
            await Db.SaveChangesAsync();
            Navigation.NavigateTo("/forum");
        }
    }

    public class WpisModel
    {
        [Required(ErrorMessage = "Podaj tytuł")] [StringLength(100)] public string Tytul { get; set; } = "";
        [Required(ErrorMessage = "Wpisz jakąś treść")] public string Tresc { get; set; } = "";
    }
}
