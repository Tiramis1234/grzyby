@page "/forum/nowy"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using grzyby.Data
@using grzyby.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Nowy Wpis</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h2 class="fw-bold mb-4">Utwórz nowy wpis</h2>

                <EditForm Model="Input" method="post" OnValidSubmit="DodajWpis" FormName="createPost">
                    <AntiforgeryToken /> <!-- TO JEST KLUCZOWE -->
                    <DataAnnotationsValidator />

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Tytuł wpisu</label>
                        <InputText @bind-Value="Input.Tytul" class="form-control form-control-lg bg-light border-0" placeholder="O czym chcesz napisać?" />
                        <ValidationMessage For="() => Input.Tytul" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Treść</label>
                        <InputTextArea @bind-Value="Input.Tresc" class="form-control bg-light border-0" rows="8" placeholder="Rozpisz się tutaj..." />
                        <ValidationMessage For="() => Input.Tresc" class="text-danger small mt-1" />
                    </div>

                    <div class="d-flex justify-content-end gap-3">
                        <a href="/forum" class="btn btn-light rounded-pill px-4">Anuluj</a>
                        <button type="submit" class="btn btn-dark rounded-pill px-5 fw-bold">Opublikuj</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private WpisModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new WpisModel();
    }

    private async Task DodajWpis()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            var nowyWpis = new Wpis
            {
                Tytul = Input.Tytul,
                Tresc = Input.Tresc,
                DataDodania = DateTime.UtcNow,
                AuthorId = user.Id
            };

            Db.Wpisy.Add(nowyWpis);
            await Db.SaveChangesAsync();

            Navigation.NavigateTo("/forum");
        }
    }

    public class WpisModel
    {
        [Required(ErrorMessage = "Podaj tytuł")]
        [StringLength(100, ErrorMessage = "Tytuł może mieć max 100 znaków")]
        public string Tytul { get; set; } = "";

        [Required(ErrorMessage = "Wpisz jakąś treść")]
        public string Tresc { get; set; } = "";
    }
}