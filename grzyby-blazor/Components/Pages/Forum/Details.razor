@page "/forum/{Id:int}"
@using grzyby.Data
@using grzyby.Models
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject ApplicationDbContext Db
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(wpis?.Tytul ?? "Wpis nie znaleziony")</PageTitle>

<div class="main-wrap" style="grid-template-columns:1fr; max-width:720px;">
    <main>
        @if (wpis == null)
        {
            <div style="text-align:center;padding:60px 0;">
                <div style="font-size:3rem; color:var(--cf); margin-bottom:12px;">
                    <i class="bi bi-search"></i>
                </div>
                <h3 style="font-family:var(--fs); color:var(--cud);">Nie znaleziono takiego wpisu.</h3>
                <a href="/forum" class="btn-primary-custom" style="display:inline-flex;margin-top:12px;">
                    <i class="bi bi-arrow-left"></i> Wróć do forum
                </a>
            </div>
        }
        else
        {
            <div class="mb-3">
                <a href="/forum" class="btn-ghost" style="display:inline-flex;">
                    <i class="bi bi-arrow-left"></i> Wróć do forum
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5" style="background:var(--cr);">
                <h1 style="font-family:var(--fs); font-size:1.6rem; font-weight:600; color:var(--cb); margin-bottom:1rem;">
                    @wpis.Tytul
                </h1>

                <div class="d-flex align-items-center mb-4 pb-4 border-bottom" style="border-color:var(--cf) !important;">
                    <div class="rounded-circle d-flex justify-content-center align-items-center fw-bold me-3 shadow-sm" style="width:44px; height:44px; font-size:1rem; background:var(--cud); color:var(--cr);">
                        @(string.IsNullOrEmpty(wpis.Author?.UserName) ? "?" : wpis.Author.UserName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <strong style="color:var(--cud); font-size:1rem;">@(wpis.Author?.UserName ?? "Usunięty użytkownik")</strong>
                        <div style="font-size:0.72rem; color:var(--cu);">
                            <i class="bi bi-clock"></i> @wpis.DataDodania.ToString("dd MMMM yyyy, HH:mm")
                        </div>
                    </div>
                </div>

                <div style="font-size:1rem; line-height:1.7; color:var(--cb); white-space:pre-wrap;">
                    @wpis.Tresc
                </div>
            </div>

            <div class="section-lbl">
                <i class="bi bi-chat-dots"></i> Komentarze 
                <span class="badge rounded-pill" style="background:var(--ccl); color:var(--cr); font-family:var(--fm); margin-left:4px;">@wpis.Komentarze.Count</span>
            </div>

            <div class="mb-5">
                @if (!wpis.Komentarze.Any())
                {
                    <div style="background:var(--cp); border:1px solid var(--cf); border-radius:8px; padding:24px; text-align:center; color:var(--cu); font-size:0.82rem;">
                        Nikt jeszcze nie skomentował. Podziel się swoimi myślami!
                    </div>
                }
                else
                {
                    @foreach (var kom in wpis.Komentarze.OrderBy(k => k.DataDodania))
                    {
                        <div style="background:var(--cr); border-left:3px solid var(--ccl); border-radius:0 8px 8px 0; padding:14px 16px; margin-bottom:10px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong style="color:var(--csd); font-size:0.82rem;">
                                    <i class="bi bi-person-circle" style="margin-right:4px;"></i>@(kom.Author?.UserName ?? "Nieznany")
                                </strong>
                                <span style="color:var(--cu); font-size:0.68rem;">@kom.DataDodania.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                            <p style="margin:0; color:var(--cb); font-size:0.9rem; white-space:pre-wrap;">@kom.Tresc</p>
                        </div>
                    }
                }
            </div>

            <AuthorizeView>
                <Authorized>
                    <div style="background:var(--cr); border:1px solid var(--cf); border-radius:8px; padding:20px;">
                        <EditForm Model="Input" method="post" FormName="KomentarzForm" OnValidSubmit="DodajKomentarz" Context="editContext">
                            <DataAnnotationsValidator />
                            <div class="mb-3">
                                <label style="font-weight:600; font-size:0.85rem; color:var(--cud); display:block; margin-bottom:6px;">
                                    <i class="bi bi-pencil"></i> Dołącz do dyskusji
                                </label>
                                <InputTextArea @bind-Value="Input.Tresc" class="form-control p-3 border-0" rows="3" style="background:var(--cp); font-size:0.9rem;" placeholder="Napisz, co o tym myślisz..." />
                                <ValidationMessage For="() => Input.Tresc" class="text-danger small mt-1" />
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn-primary-custom" style="border:none;">
                                    <i class="bi bi-send"></i> Dodaj odpowiedź
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div style="background:var(--cp); border:1px solid var(--cf); border-left:3px solid var(--ccl); border-radius:8px; padding:20px; text-align:center;">
                        <p style="color:var(--cu); margin-bottom:12px;">
                            <i class="bi bi-lock"></i> Musisz być zalogowany, aby dodać komentarz.
                        </p>
                        <a href="/login" class="btn-primary-custom" style="display:inline-flex;">
                            <i class="bi bi-box-arrow-in-right"></i> Zaloguj się
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        }
    </main>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Wpis? wpis;

    [SupplyParameterFromForm]
    public NowyKomentarzModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new NowyKomentarzModel();
        await ZaladujWpis();
    }

    private async Task ZaladujWpis()
    {
        wpis = await Db.Wpisy.Include(w => w.Author).Include(w => w.Komentarze).ThenInclude(k => k.Author).AsNoTracking().FirstOrDefaultAsync(w => w.Id == Id);
    }

    private async Task DodajKomentarz()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user != null && wpis != null)
        {
            var nowyKomentarz = new Komentarz { Tresc = Input.Tresc, DataDodania = DateTime.UtcNow, WpisId = this.Id, AuthorId = user.Id };
            Db.Add(nowyKomentarz);
            await Db.SaveChangesAsync();
            Input = new NowyKomentarzModel();
            await ZaladujWpis();
        }
    }

    public class NowyKomentarzModel { [Required(ErrorMessage = "Komentarz nie może być pusty.")] public string Tresc { get; set; } = ""; }
}
