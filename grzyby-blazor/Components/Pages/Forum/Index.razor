@page "/forum"
@using grzyby.Data
@using grzyby.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>Forum Grzybiarzy</PageTitle>

<div class="main-wrap">
    <main>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <div class="section-lbl">Forum dyskusyjne</div>
                <h1 style="font-family:var(--fs); font-size:1.6rem; font-weight:600; color:var(--cb); margin:0;">
                    Forum Grzybiarzy
                </h1>
            </div>
            <AuthorizeView>
                <Authorized>
                    <a href="/forum/nowy" class="btn-primary-custom">
                        <i class="bi bi-plus-lg"></i> Nowy wpis
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn-ghost">
                        <i class="bi bi-box-arrow-in-right"></i> Zaloguj się, aby napisać
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @if (wpisy is null)
        {
            <div style="text-align:center;padding:48px 0;">
                <div class="spinner-border" role="status" style="color:var(--cm);"></div>
            </div>
        }
        else if (!wpisy.Any())
        {
            <div style="text-align:center;padding:40px 0;">
                <div style="font-size:2.5rem; color:var(--cf); margin-bottom:8px;">
                    <i class="bi bi-inbox"></i>
                </div>
                <h4 style="font-family:var(--fs); color:var(--cud);">Pusto w lesie...</h4>
                <p style="color:var(--cu);">Jeszcze nikt nic nie napisał. Przetrzyj szlaki i bądź pierwszy!</p>
            </div>
        }
        else
        {
            @foreach (var wpis in wpisy)
            {
                var initial = string.IsNullOrEmpty(wpis.Author?.UserName) ? "?" : wpis.Author.UserName.Substring(0, 1).ToUpper();
                var avClass = wpis.Id % 3 == 0 ? "s" : (wpis.Id % 3 == 1 ? "c" : "u");
                <div class="thread">
                    <div class="av @avClass">@initial</div>
                    <div>
                        <a href="/forum/@wpis.Id" class="t-title">@wpis.Tytul</a>
                        <div class="t-meta">
                            <span>@(wpis.Author?.UserName ?? "Nieznany")</span>
                            <span>·</span>
                            <span>@wpis.DataDodania.ToString("dd.MM.yyyy, HH:mm")</span>
                        </div>
                    </div>
                    <div class="t-stat">
                        <div class="t-num">@wpis.Komentarze.Count</div>
                        <div class="t-lbl"><i class="bi bi-chat"></i></div>
                    </div>
                </div>
            }
        }
    </main>

    <aside class="sidebar">
        <div class="widget">
            <div class="wh"><i class="bi bi-info-circle"></i> O forum</div>
            <div class="wb">
                <p style="font-size:0.78rem; color:var(--cu); line-height:1.6; margin:0;">
                    Dziel się swoimi znaleziskami, zadawaj pytania i rozmawiaj z innymi pasjonatami grzybobrania.
                </p>
            </div>
        </div>

        <div class="widget">
            <div class="wh"><i class="bi bi-bar-chart"></i> Statystyki</div>
            <div class="wb" style="padding:4px 12px;">
                <div class="cat-item">
                    <div class="cat-left">
                        <span class="cat-dot" style="background:var(--ccl);"></span>
                        Wszystkich wpisów
                    </div>
                    <span class="cat-count">@wpisy?.Count ?? 0</span>
                </div>
            </div>
        </div>
    </aside>
</div>

@code {
    private List<Wpis>? wpisy;

    protected override async Task OnInitializedAsync()
    {
        wpisy = await Db.Wpisy.Include(w => w.Author).Include(w => w.Komentarze).OrderByDescending(w => w.DataDodania).AsNoTracking().ToListAsync();
    }
}
